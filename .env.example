# Configuracoes do Laika (ONG Patas e Pelos)
# Copie para .env e preencha os valores reais.

# Banco de dados
# Local rapido (SQLite): sqlite:///./laika.db
# Docker / Producao (PostgreSQL): postgresql+psycopg://postgres:postgres@postgres:5432/laika
DATABASE_URL=sqlite:///./laika.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=laika

# Seguranca JWT
SECRET_KEY=troque-esta-chave-secreta-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Armazenamento de fotos de perfil e uploads
UPLOAD_DIR=/tmp/uploads/laika

# E-mails com acesso administrador automatico (separados por virgula)
ADMIN_EMAILS=coordenacao@patasepelos.org.br

# Google OAuth 2.0 (OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Contato publico da ONG (catalogo de adocao)
ONG_WHATSAPP=5555996112233

# Popular banco vazio com dados de demonstracao? (false = banco 100% limpo)
SEED_DEMO_DATA=false
